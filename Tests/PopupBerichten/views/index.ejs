<!DOCTYPE html>
<html>

<head>
    <title>Bootstrap Popup Form</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        .modal-content {
            padding: 1rem;
        }

        .modal-body {
            padding-bottom: 1.5rem;
        }
    </style>
</head>

<body class="p-4">

    <h1 class="mb-4">Popup Form Example</h1>

    <!-- Button to open modal -->
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#popupForm">
        Open Form
    </button>

    <!-- Modal -->
    <div class="modal fade" id="popupForm" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 600px;">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Nieuwe taak</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form action="/submit-form" method="POST">

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">First Field</label>
                            <input type="text" name="fieldOne" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Second Field</label>
                            <input type="text" name="fieldTwo" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Select Date</label>
                            <input type="date" name="dateField" class="form-control">
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-success">Submit</button>
                    </div>

                </form>

            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>